NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

DATABASE_URL="postgresql://crm_user:crm_password@localhost:5432/crm_dev?schema=public"

JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
# Refresh tokens are opaque random strings, hashed and stored in the DB
# (with rotation + reuse detection) rather than JWTs, so no separate secret is needed.

COOKIE_SECURE=false

# Phase 9 — AI Lead Scoring. Optional: if unset, the AI insight endpoint
# returns a clear "not configured" error instead of crashing, and the
# rule-based scorer (lib/lead-scoring.ts) keeps working either way.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# claude-haiku-4-5-20251001 is a faster/cheaper alternative if you're scoring
# leads at high volume and don't need the extra reasoning quality.
